                        iconFilename = urllib.parse.urlparse(xmlChannel["icon"][0])[
                            2
                        ].rpartition("/")[2]
                        downloadFileData = {}
                        downloadFileData["StorageGroup"] = "ChannelIcons"
                        downloadFileData["URL"] = xmlChannel["icon"][0]
                        if s.Content("DownloadFile", downloadFileData)["bool"]:
                            data["Icon"] = iconFilename
                            update = True
                        else:
                            print(
                                f"   Channel {mythChannel['ChanNum']} icon download failed"
                            )
                        if args.extraIcons:
                            for icon in xmlChannel["icon"][1:]:
                                downloadFileData = {}
                                downloadFileData["StorageGroup"] = "ChannelIcons"
                                downloadFileData["URL"] = icon
                                if s.Content("DownloadFile", downloadFileData)["bool"]:
                                    pass
                                else:
                                    print(
                                        f"   Channel {mythChannel['ChanNum']} extra icon download failed"
                                    )
                elif (len(xmlChannel["icon"]) == 0) and (mythChannel["IconURL"] != ""):
                    print(f"Channel {mythChannel['ChanNum']} icon is no longer valid")
                    if not args.noUpdateIcons:
                        data["Icon"] = ""
                        update = True
                else:
                    # xmlChannel and mythChannel both have icons.
                    if not args.noStrictIcon:
                        # comparing is expensive, so allow one to accept that icons are icons
                        mythChannelIcon = None

                        try:
                            mythChannelIcon = s.Guide(
                                "GetChannelIcon",
                                {"ChanID": mythChannel["ChanId"]},
                                stream=True,
                            )
                        except httpx.HTTPError:
                            print(
                                f"Channel {mythChannel['ChanNum']} icon request with ChanId failed."
                            )

                        if not mythChannelIcon:
                            try:
                                mythChannelIcon = s.Guide(
                                    "GetChannelIcon",
                                    {"FileName": mythChannel["Icon"]},
                                    stream=True,
                                )
                            except httpx.HTTPError:
                                print(
                                    f"Channel {mythChannel['ChanNum']} icon request with FileName failed."
                                )

                        if not mythChannelIcon:
                            print(
                                f"Channel {mythChannel['ChanNum']} icon cannot be retrieved from the backend"
                            )
                            mythChannelIcon = b""

                        mythChannelIconHash = hashlib.sha256(
                            mythChannelIcon
                        ).hexdigest()
                        try:
                            xmlIcon = client.get(xmlChannel["icon"][0]).content
                        except httpx.HTTPError:
                            print(
                                f"Channel {xmlChannel['channum']} icon cannot be retrieved from source"
                            )
                            xmlIcon = b""
                        xmlIconHash = hashlib.sha256(xmlIcon).hexdigest()
                        if (xmlIconHash != mythChannelIconHash) or args.refreshIcons:
                            if xmlIconHash != mythChannelIconHash:
                                print(
                                    f"Channel {mythChannel['ChanNum']} icon differs from source"
                                )
                            elif (not args.noUpdateIcons) and (args.update):
                                print(
                                    f"Channel {mythChannel['ChanNum']} icon refresh forced"
                                )
                            if (not args.noUpdateIcons) and (args.update):
                                iconFilename = urllib.parse.urlparse(
                                    xmlChannel["icon"][0]
                                )[2].rpartition("/")[2]
                                downloadFileData = {}
                                downloadFileData["StorageGroup"] = "ChannelIcons"
                                downloadFileData["URL"] = xmlChannel["icon"][0]
                                if s.Content("DownloadFile", downloadFileData)["bool"]:
                                    data["Icon"] = iconFilename
                                    update = True
                                else:
                                    print(
                                        f"   Channel {mythChannel['ChanNum']} icon download failed"
                                    )
                                if args.extraIcons:
                                    for icon in xmlChannel["icon"][1:]:
                                        downloadFileData = {}
                                        downloadFileData["StorageGroup"] = (
                                            "ChannelIcons"
                                        )
                                        downloadFileData["URL"] = icon
                                        if s.Content("DownloadFile", downloadFileData)[
                                            "bool"
                                        ]:
                                            pass
                                        else:
                                            print(
                                                f"   Channel {mythChannel['ChanNum']} "
                                                "extra icon download failed"
                                            )
                if xmlChannel["freqid"] != mythChannel["FrequencyId"]:
                    print(
                        f"Channel {mythChannel['ChanNum']} with existing frequency id: "
                        f'"{mythChannel["FrequencyId"]}" has a revised frequency id: {xmlChannel["freqid"]}'
                    )
                    if not args.noUpdateFreqID:
                        data["FrequencyId"] = xmlChannel["freqid"]
                        update = True
                if (xmlChannel["atscMajor"] != int(mythChannel["ATSCMajorChan"])) or (
                    xmlChannel["atscMinor"] != int(mythChannel["ATSCMinorChan"])
                ):
                    print(
                        "Channel {} with existing ATSC channel number {}.{} has a revised ATSC channel number {}.{}".format(
                            mythChannel["ChanNum"],
                            mythChannel["ATSCMajorChan"],
                            mythChannel["ATSCMinorChan"],
                            xmlChannel["atscMajor"],
                            xmlChannel["atscMinor"],
                        )
                    )
                    if not args.noUpdateATSC:
                        data["ATSCMajorChan"] = xmlChannel["atscMajor"]
                        data["ATSCMinorChan"] = xmlChannel["atscMinor"]
                        update = True
                if xmlChannel["xmltvid"] != mythChannel["XMLTVID"]:
                    print(
                        'Channel {} with existing XMLTVID: "{}" has a revised XMLTVID: "{}"'.format(
                            mythChannel["ChanNum"],
                            mythChannel["XMLTVID"],
                            xmlChannel["xmltvid"],
                        )
                    )
                    if not args.noUpdateXMLTVID:
                        data["XMLTVID"] = xmlChannel["xmltvid"]
                        update = True
                if xmlChannel["callsign"] != mythChannel["CallSign"]:
                    print(
                        'Channel {} with existing callsign: "{}" has a revised callsign: "{}"'.format(
                            mythChannel["ChanNum"],
                            mythChannel["CallSign"],
                            xmlChannel["callsign"],
                        )
                    )
                    if not args.noUpdateCallsign:
                        data["CallSign"] = xmlChannel["callsign"]
                        update = True
                if xmlChannel["name"] != mythChannel["ChannelName"]:
                    print(
                        'Channel {} with existing name: "{}" has a new name: "{}"'.format(
                            mythChannel["ChanNum"],
                            mythChannel["ChannelName"],
                            xmlChannel["name"],
                        )
                    )
                    if not args.noUpdateName:
                        data["ChannelName"] = xmlChannel["name"]
                        update = True
                if update and args.update:
                    if s.Channel(
                        "UpdateDBChannel", transformAPIElementNames("Channel", data)
                    )["bool"]:
                        print(
                            f"  Channel {mythChannel['ChanNum']} updated with:\n{data}"
                        )
                    else:
                        print(
                            "  Channel {} update failed".format(mythChannel["ChanNum"])
                        )

            if (not found) and (
                (args.noReport is None) or ("new" not in args.noReport)
            ):
                mythName = xmlName
                print(
                    f"Channel {xmlChannel['channum']},",
                    f'callsign: "{xmlChannel["callsign"]}",',
                    f'name: "{xmlChannel["name"]}" is new',
                )
                if args.add:
                    # Attempt to download icon (if not excluded)
                    iconFilename = ""
                    if not args.noUpdateIcons:
                        if len(xmlChannel["icon"]) > 0:
                            downloadFileData = {}
                            downloadFileData["StorageGroup"] = "ChannelIcons"
                            downloadFileData["URL"] = xmlChannel["icon"][0]
                            if s.Content("DownloadFile", downloadFileData)["bool"]:
                                iconFilename = urllib.parse.urlparse(
                                    xmlChannel["icon"][0]
                                )[2].rpartition("/")[2]
                            else:
                                print(
                                    f"   Channel {xmlChannel['channum']} icon download failed"
                                )
                            if args.extraIcons:
                                for icon in xmlChannel["icon"][1:]:
                                    downloadFileData = {}
                                    downloadFileData["StorageGroup"] = "ChannelIcons"
                                    downloadFileData["URL"] = icon
                                    if s.Content("DownloadFile", downloadFileData)[
                                        "bool"
                                    ]:
                                        pass
                                    else:
                                        print(
                                            '   Channel {xmlChannel["channum"]} extra icon download failed'
                                        )
                        # We need to create a valid ChannelID:
                        try:
                            chanId = sourceId * 10000 + int(xmlChannel["channum"])
                        except Exception:
                            chanId = sourceId * 10000
                        while True:
                            try:
                                data = {}
                                data["ChanID"] = chanId
                                if (
                                    int(
                                        s.Channel("GetChannelInfo", data)[
                                            "ChannelInfo"
                                        ]["ChanId"]
                                    )
                                    == 0
                                ):
                                    break
                            except Exception:
                                break
                            chanId += 1
                        data = {}
                        data["ChanId"] = chanId
                        data["SourceId"] = sourceId
                        data["ChanNum"] = xmlChannel["channum"]
                        data["FrequencyId"] = xmlChannel["freqid"]
                        data["XMLTVID"] = xmlChannel["xmltvid"]
                        data["CallSign"] = xmlChannel["callsign"]
                        data["ChannelName"] = xmlChannel["name"]
                        data["Icon"] = iconFilename
                        data["ATSCMajorChan"] = xmlChannel["atscMajor"]
                        data["ATSCMinorChan"] = xmlChannel["atscMinor"]
                        data["DefaultAuth"] = ""
                        data["Format"] = "Default"
                        if ChannelServiceVersion >= versionTuple("1.9"):
                            data["ExtendedVisible"] = args.extendedvisible
                        else:
                            data["Visible"] = args.extendedvisible in [
                                "Visible",
                                "Always Visible",
                            ]
                        data["UseEIT"] = 0
                        data["MplexId"] = 0
                        data["ServiceId"] = 0
                        if s.Channel(
                            "AddDBChannel",
                            transformAPIElementNames("Channel", data)["bool"],
                        ):
                            print(f"  Channel {xmlChannel['channum']} added")
                            mythChannel = data.copy()
                            mythChannel["IconURL"] = data["Icon"]
                            mythChannel["FineTune"] = 0
                            mythChannel["ChanFilters"] = ""
                            mythChannel["InputId"] = 0
                            mythChannel["CommFree"] = False
                            mythChannel["DefaultAuth"] = ""
                            mythChannel["Programs"] = []
                            mythNames[mythName] = mythChannel
                        else:
                            print('  Channel {xmlChannel["channum"]} addition failed')

    if args.add or args.delete or args.update:
        try:
            s.Dvr("RescheduleRecordings", method="post")
        except Exception:
            pass

    sys.exit(0)
