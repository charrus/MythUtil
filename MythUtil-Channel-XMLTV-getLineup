        if host is None:
            host = "localhost"
        self.host = host
        if port is None:
            port = 6544
        self.port = port
        self.session = httpx.Client()
        if username and password:
            self.session.auth = httpx.DigestAuth(username=username, password=password)
            self.request(service="Myth", api="version")

    def request(self, service=None, api=None, data=None, method=None, stream=False):
        if data is None:
            data = {}
        version = "0.28"
        headers = {
            "User-Agent": f"{version} Python Services API Client",
            "Accept": "application/json",
            "Accept-Encoding": "gzip,deflate",
        }
        if api is None:
            raise ValueError("api must be specified")
        url = f"http://{self.host}:{self.port}/{service}/{api}"
        if method is None:
            if bool(data):
                method = "post"
            else:
                method = "get"
        if method == "get":
            response = self.session.get(url, headers=headers, params=data)
        elif method == "post":
            response = self.session.post(url, headers=headers, data=data)
        else:
            raise ValueError(f"method is not post or get: {method}")
        if not response.is_success:
            # print(f'URL: {url}, Reason: {response.reason_phrase}')
            response.raise_for_status()
        if stream:
            return response.content
        else:
            return response.json()

